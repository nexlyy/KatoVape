# /opt/katovape/.env — настройки БОТА на сервере. Права 600, в git НЕ коммитим.
# На сервере живёт ТОЛЬКО бот (long polling): ни nginx, ни домена, ни хостинга сайта.
# Мини-апп и админка — на GitHub Pages, сервер их не отдаёт. Данные — в Supabase.

# Токен бота от @BotFather. Без него бот не стартует.
TELEGRAM_BOT_TOKEN=

# Supabase: адрес проекта и СЕКРЕТНЫЙ service-ключ (бот ходит мимо RLS, наружу ключ не отдаём)
SUPABASE_URL=https://vffqnydxofvunwausakv.supabase.co
SUPABASE_SERVICE_KEY=

# Мини-приложение (на GitHub Pages) — его откроет кнопка-меню бота
MINIAPP_URL=https://nexlyy.github.io/KatoVape/demos/vapor/app/

# Панель управления: ссылка для команды /admin
KV_ADMIN_URL=https://nexlyy.github.io/KatoVape/demos/admin/

# Запасной список получателей уведомлений на случай пустой таблицы admins (id владельца).
# В обычной работе адресатов бот берёт из admins: заказ уходит менеджеру своего города.
KV_MANAGER_IDS=5301671230

# Как часто бот проверяет очереди Supabase (заказы, брони, рассылки), мс
KV_JOBS_MS=10000

# Ассортимент из Google Sheets: URL опубликованной CSV. Сейчас не используется
# (ассортимент правится в админке), можно оставить пустым.
KV_SHEETS_CSV=
